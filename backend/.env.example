# Copy this file to .env and fill in the key. Never commit .env.
# Write only KEY=value on a line: no comment after a value, no "export".

# The key from https://console.groq.com (starts with gsk_).
GROQ_API_KEY=

# "groq" for real answers, "fake" for fixed test answers without a key.
PROVIDER=groq

# The model that writes the answers. Check the Groq console for current ids.
GROQ_MODEL=openai/gpt-oss-120b

# How much the model thinks before answering: low, medium, high, or none for
# models that do not have this setting (Groq rejects it for those).
GROQ_REASONING_EFFORT=low

# Websites that may call this API, separated by commas.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Usage limits.
REQUESTS_PER_MINUTE=4
REQUESTS_PER_HOUR=20
REQUESTS_PER_DAY=100

# Set to true only when the host puts the visitor address in X-Forwarded-For.
TRUST_PROXY=false

# A header in which the host itself names the visitor's address. Leave empty on
# your own computer. On Render: cf-connecting-ip (already set in render.yaml).
CLIENT_IP_HEADER=
